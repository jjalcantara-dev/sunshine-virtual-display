# sunshine-virtual-display settings (sourced by the scripts as shell variables)

# Connector used for the virtual display (must match the kernel parameters)
VIRTUAL=HDMI-A-1
# The virtual display follows the resolution and fps requested by the Moonlight client when the EDID
# has that mode (MATCH_CLIENT=1). VIRTUAL_MODE is only used when it does not.
MATCH_CLIENT=1
VIRTUAL_MODE=3840x2160@60
# auto = 200% at 4K, 150% at 1440p, 100% below, so the desktop stays readable from the couch
VIRTUAL_SCALE=auto

# Your main real monitor and its mode (optional but recommended). See `kscreen-doctor -o`.
PRIMARY=DP-2
PRIMARY_MODE=2560x1440@144

# Session locking. With UNLOCK_ON_STREAM=1, any paired Moonlight client gets an unlocked desktop.
UNLOCK_ON_STREAM=1
LOCK_ON_STREAM_END=0
# Lock the session right after login. Only useful with auto-login; 0 if you type your password to log in
LOCK_ON_LOGIN=0
# Close the Sunshine session (bringing the monitors back) when the client has been gone this many
# seconds, e.g. the TV froze or was turned off. 0 disables it.
DISCONNECT_TIMEOUT=120
